<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvItemCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:background="@drawable/bg_category_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvItemCompletedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#166534"
                android:background="@drawable/bg_completed_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvItemAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="by Author Name"
            android:textSize="14sp"
            android:textColor="#475569"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvItemContentSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Short book description goes here..."
            android:textSize="13sp"
            android:textColor="#64748B"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvItemPdfUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open PDF Link"
            android:textSize="12sp"
            android:textColor="#2563EB"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tvItemProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progress: 50 / 100 pages (50.0%)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:layout_marginTop="10dp" />

        <ProgressBar
            android:id="@+id/pbItemProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:layout_marginTop="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvItemRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rating: 5/5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#D97706" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvItemDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Added: 2026-11-15"
                android:textSize="12sp"
                android:textColor="#64748B" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>