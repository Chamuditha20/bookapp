<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="16dp">

    <!-- Screen Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Reading List"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Reading Summary Dashboard -->
    <TextView
        android:id="@+id/tvSummaryStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Items: 0  |  Completed: 0"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1E40AF"
        android:background="#DBEAFE"
        android:padding="10dp"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- Search Bar -->
    <EditText
        android:id="@+id/etSearchBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search by Title or Author..."
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:textColor="#0F172A"
        android:layout_marginBottom="12dp" />

    <!-- RecyclerView for displaying items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewBooks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp" />

    <!-- Back Button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Dashboard"
        android:backgroundTint="#475569"
        android:textColor="#FFFFFF"
        android:padding="12dp" />

</LinearLayout>